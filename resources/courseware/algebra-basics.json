  "lessons": {
    "linear-equations-intro": {
      "title": "Solving Linear Equations",
      "description": "Learn how to isolate a variable by undoing operations in reverse order.",
      "blocks": [
        {
          "type": "heading",
          "text": "The goal"
        },
        {
          "type": "paragraph",
          "text": "A linear equation asks for the value that makes both sides equal. To solve it, keep the equation balanced while isolating the variable."
        },
        {
          "type": "example",
          "title": "Example",
          "body": "Solve 3x + 4 = 19. Subtract 4 from both sides to get 3x = 15, then divide by 3 to get x = 5."
        }
      ]
    }
  },
  "homeworks": {
    "linear-equations-practice": {
      "title": "Linear Equations Practice",
